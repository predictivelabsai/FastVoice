# Copy to the repo-root .env (git-ignored) or knowledge_line/.env. Never commit real keys.
# Any provider whose key is missing falls back to the next one in
# configs/default.yaml *.fallback_order, ending with offline mocks.

# --- LLM (LangChain) ---------------------------------------------------------
GEMINI_API_KEY=            # Gemini via Google AI Studio (LLM + Gemini speech); GOOGLE_API_KEY also accepted
GOOGLE_API_KEY=
MISTRAL_API_KEY=
KL_LLM_PROVIDER=auto       # auto | gemini | mistral | mock
KL_GEMINI_MODEL=gemini-2.5-flash
KL_MISTRAL_MODEL=mistral-large-latest

# --- Speech --------------------------------------------------------------------
# Google Cloud Speech-to-Text / Text-to-Speech: service account preferred
GOOGLE_APPLICATION_CREDENTIALS=      # path to service-account JSON (kept outside the repo)
GOOGLE_APPLICATION_CREDENTIALS_JSON= # or the JSON inline
GOOGLE_CLOUD_API_KEY=                # or an API key with Speech/TTS APIs enabled
KL_GOOGLE_TTS_VOICE=                 # empty = best available lt-LT voice
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=                 # empty = first premade voice
KL_ELEVENLABS_TTS_MODEL=eleven_v4_turbo   # LT-capable: eleven_v4_turbo, eleven_v4, eleven_v3
KL_ELEVENLABS_STT_MODEL=scribe_v1
# Gemini speech (uses GEMINI_API_KEY; no Cloud project needed)
KL_GEMINI_TTS_MODEL=gemini-2.5-flash-preview-tts
KL_GEMINI_TTS_VOICE=Kore
KL_GEMINI_STT_MODEL=gemini-2.5-flash
KL_GEMINI_THINKING_BUDGET=0
KL_STT_PROVIDER=auto       # auto | elevenlabs | google | gemini | azure | tilde | mock
KL_TTS_PROVIDER=auto       # auto | google | elevenlabs | gemini | azure | tilde | mock

# Stub adapters (off by default)
KL_AZURE_ENABLED=false
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope
KL_TILDE_ENABLED=false
TILDE_API_KEY=
TILDE_ENDPOINT=

# --- Profile / service -----------------------------------------------------------
KL_PROFILE=civil-protection-lt
KL_LOCALE=lt-LT
KL_SERVICE_NAME=civilinės saugos informacijos liniją
KL_DEFAULT_MUNICIPALITY=             # e.g. "Vilniaus m. sav." to bias shelter lookup
KL_HOST=127.0.0.1
KL_PORT=5055
